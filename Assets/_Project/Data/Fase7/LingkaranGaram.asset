  m_Script: {fileID: 11500000, guid: 61c3401c87cca4432bb9854f8b661f1e, type: 3}
  m_Name: LingkaranGaram
  m_EditorClassIdentifier: TheSending.Runtime::TheSending.Runtime.DataDialog
  Baris:
  - Pembicara: Bu Sumi
    Teks: Garam dan kelor sudah melingkari ranjang. Lingkaran ini tidak boleh terputus.
    Terjemahan: 
    Efek: 
    Akhir: 0
    Pilihan: []
  - Pembicara: Laras
    Teks: Ibu kelihatan lebih tenang, Mas.
    Terjemahan: 
    Efek: 
    Akhir: 0
    Pilihan: []
  - Pembicara: Bu Sumi
    Teks: Santet iki ono induke, Le. Nek induke ora diobong, kabeh mau mung ngurangi, ora mateni.
    Terjemahan: Santet ini ada induknya, Nak. Kalau induknya tidak dibakar, semua tadi cuma mengurangi, tidak mematikan.
    Efek: 
    Akhir: 0
    Pilihan: []
  - Pembicara: Raka
    Teks: Di mana induknya, Bu?
    Terjemahan: 
    Efek: 
    Akhir: 0
    Pilihan: []
  - Pembicara: Bu Sumi
    Teks: Cari di rumah orang yang kirim. Watuireng, lewat jalan sawah. Aku jaga Ibumu di sini.
    Terjemahan: 
    Efek: 
    Akhir: 0
    Pilihan: []
  - Pembicara: Raka
    Teks: Saya berangkat. Ras, jangan buka lingkarannya.
    Terjemahan: 
    Efek: 
    Akhir: 1
    Pilihan: []
